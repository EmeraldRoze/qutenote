# QuteNote — every secret the app expects, with placeholder values only.
# Copy to .env and fill in. NEVER commit .env itself.
#
# The ones marked LIVE must also exist on the DigitalOcean app (app "cutenote",
# service "api") or production simply runs without them.

# --- Database (LIVE) -------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:25060/defaultdb?sslmode=require

# --- Auth (LIVE) -----------------------------------------------------------
JWT_SECRET=run-openssl-rand-hex-32
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx

# --- Address verification (LIVE) -------------------------------------------
# Melissa License Key, from developer.melissa.com → My Account. Used by the US
# Personator check (3 credits per address). Replaced Lob on Nov 9 2026.
# If this is missing, addresses come back UNCHECKED and cards still send —
# missing on purpose, so an absent key can never block anyone.
MELISSA_LICENSE_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Lob is no longer used for verification or mailing. The only thing still
# wired to it is the address type-ahead, which has never worked on a test key.
LOB_API_KEY=test_xxxxx

# --- Payments (LIVE, unused while QuteNote is free) ------------------------
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_ID=price_xxxxx

# --- Email + push (LIVE) ---------------------------------------------------
RESEND_API_KEY=re_xxxxx
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=hello@qutenote.com
APNS_KEY_BASE64=base64-of-the-p8-file

# --- AI (LIVE) -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- App config (LIVE) -----------------------------------------------------
WEB_URL=https://qutenote.com
ADMIN_EMAIL=you@yourdomain.com

# --- Infrastructure, local tooling only (NOT on the server) ---------------
DO_API_TOKEN=dop_v1_xxxxx
GITHUB_TOKEN=ghp_xxxxx
CLOUDFLARE_API_TOKEN=xxxxx
CLOUDFLARE_ZONE_ID=xxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxx

# --- Declared but NOT actually in use -------------------------------------
# The Address table's columns are named encrypted* but store plain text; the
# encryption layer was never written (see apps/api/src/routes/address.ts).
ADDRESS_ENCRYPTION_KEY=run-openssl-rand-hex-32
